# ---- App ----------------------------------------------------------------
# Token required by /run and /cron. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=change-me

# Time zone used for the "calendar day" and the daily schedule.
TZ_NAME=Asia/Kolkata

# ---- Daily schedule ------------------------------------------------------
SCHEDULE_HOUR=15
SCHEDULE_MINUTE=42
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
# How many past days a restarted service may fill in (0 disables backfill).
CATCH_UP_DAYS=1

# ---- Story (LLM) --------------------------------------------------------
# Point this at any Ollama server (a reachable host, or a bigger free box).
# Leave it empty to disable the LLM and use the built-in offline writer,
# which is what free 512 MB instances should do.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=180000
STORY_THEME=motivation
STORY_WORDS=120

# ---- Text to speech ------------------------------------------------------
# auto | piper | espeak | gtts
# auto = piper (if PIPER_VOICE is set) -> espeak-ng -> gtts
TTS_ENGINE=auto
# Optional neural voice, e.g. /opt/voices/en_US-amy-medium.onnx (needs `piper`)
PIPER_VOICE=
GTTS_LANG=en

# ---- Render --------------------------------------------------------------
WIDTH=1080
HEIGHT=1920
FPS=30
CRF=26
PRESET=veryfast
ZOOM_RATE=0.0004
ACCENT_COLOR=#E8B44A
CHANNEL_NAME=Daily Short
# Bundled image already sets this; only needed for non-Docker hosts.
FONT_PATH=
ENABLE_GRAIN=false
MAX_AUDIO_SECONDS=120

# ---- Google Drive -------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=
# Recommended on a server (no browser available): a service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Desktop OAuth client JSON (only if you also run this on a laptop).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Keep the story JSON next to the video in Drive so state survives redeploys.
UPLOAD_STORY=true